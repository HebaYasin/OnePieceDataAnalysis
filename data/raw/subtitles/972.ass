Dialogue: 0,0:01:21.47,0:01:24.18,On Top,,0,0,0,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:21.47,0:01:24.18,Default,,0,0,0,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:24.22,0:01:28.94,On Top,,0,0,0,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:24.22,0:01:28.94,Default,,0,0,0,,{\i1}Stay true to yourself{\i0}
