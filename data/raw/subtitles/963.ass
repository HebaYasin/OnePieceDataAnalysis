Dialogue: 0,0:00:16.80,0:00:21.35,On Top,,0,0,0,,{\i1}Let's sail on takaku ho wo agete{\i0}
Dialogue: 0,0:00:21.39,0:00:24.10,Default,,0,0,0,,{\i1}Catch the wind{\i0}
Dialogue: 0,0:00:21.39,0:00:24.10,On Top,,0,0,0,,{\i1}kaze ni nore{\i0}
Dialogue: 0,0:00:29.73,0:00:33.61,Default,,0,0,0,,{\i1}Don't give up, if I'm determined{\i0}
Dialogue: 0,0:00:29.73,0:00:33.61,On Top,,0,0,0,,{\i1}Don't give up kakugo kimetano nara{\i0}
Dialogue: 0,0:00:33.65,0:00:36.87,Default,,0,0,0,,{\i1}I'll never turn back{\i0}
Dialogue: 0,0:00:33.65,0:00:36.87,On Top,,0,0,0,,{\i1}hikikaeshi wa shinai sa{\i0}
Dialogue: 0,0:00:36.91,0:00:40.16,Default,,0,0,0,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:36.91,0:00:40.16,On Top,,0,0,0,,{\i1}waraitobase aranami{\i0}
Dialogue: 0,0:00:40.41,0:00:44.96,Default,,0,0,0,,{\i1}Shout it out, to save your spirit from breaking{\i0}
Dialogue: 0,0:00:40.41,0:00:44.96,On Top,,0,0,0,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:45.00,0:00:47.42,Default,,0,0,0,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:45.00,0:00:47.42,On Top,,0,0,0,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:47.46,0:00:53.84,Default,,0,0,0,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:47.46,0:00:53.84,On Top,,0,0,0,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:53.88,0:00:57.93,Default,,0,0,0,,{\i1}Even when the darkness tries to tear you apart{\i0}
Dialogue: 0,0:00:53.88,0:00:57.93,On Top,,0,0,0,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:57.97,0:00:59.22,Default,,0,0,0,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:57.97,0:00:59.22,On Top,,0,0,0,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:59.26,0:01:00.72,Default,,0,0,0,,{\i1}It's going to be all right{\i0}
Dialogue: 0,0:00:59.26,0:01:00.72,On Top,,0,0,0,,{\i1}daijoubu sa{\i0}
Dialogue: 0,0:01:00.76,0:01:04.43,Default,,0,0,0,,{\i1}Strong bonds will break through{\i0}
Dialogue: 0,0:01:00.76,0:01:04.43,On Top,,0,0,0,,{\i1}uchiyaburu saikyo no kizuna{\i0}
