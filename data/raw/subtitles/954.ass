Dialogue: 0,0:00:21.60,0:00:24.31,On Top,,0,0,0,,{\i1}kaze ni nore{\i0}
Dialogue: 0,0:00:29.94,0:00:33.82,Default,,0,0,0,,{\i1}Don't give up, if I'm determined{\i0}
Dialogue: 0,0:00:29.94,0:00:33.82,On Top,,0,0,0,,{\i1}Don't give up kakugo kimetano nara{\i0}
Dialogue: 0,0:00:33.86,0:00:37.07,Default,,0,0,0,,{\i1}I'll never turn back{\i0}
Dialogue: 0,0:00:33.86,0:00:37.07,On Top,,0,0,0,,{\i1}hikikaeshi wa shinai sa{\i0}
Dialogue: 0,0:00:37.11,0:00:40.37,Default,,0,0,0,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:37.11,0:00:40.37,On Top,,0,0,0,,{\i1}waraitobase aranami{\i0}
Dialogue: 0,0:00:40.62,0:00:45.16,Default,,0,0,0,,{\i1}Shout it out, to save your spirit from breaking{\i0}
Dialogue: 0,0:00:40.62,0:00:45.16,On Top,,0,0,0,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:45.21,0:00:47.62,Default,,0,0,0,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:45.21,0:00:47.62,On Top,,0,0,0,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:47.67,0:00:54.05,Default,,0,0,0,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:47.67,0:00:54.05,On Top,,0,0,0,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:54.09,0:00:58.14,Default,,0,0,0,,{\i1}Even when the darkness tries to tear you apart{\i0}
Dialogue: 0,0:00:54.09,0:00:58.14,On Top,,0,0,0,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:58.18,0:00:59.43,Default,,0,0,0,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:58.18,0:00:59.43,On Top,,0,0,0,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:59.47,0:01:00.93,Default,,0,0,0,,{\i1}It's going to be all right{\i0}
Dialogue: 0,0:00:59.47,0:01:00.93,On Top,,0,0,0,,{\i1}daijoubu sa{\i0}
