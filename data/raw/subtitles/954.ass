Dialogue: 0,0:01:18.74,0:01:21.58,On Top,,0,0,0,,{\i1}chikai atsumeta hata{\i0}
Dialogue: 0,0:01:21.62,0:01:24.29,Default,,0,0,0,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:21.62,0:01:24.29,On Top,,0,0,0,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:24.33,0:01:29.04,Default,,0,0,0,,{\i1}Stay true to yourself{\i0}
Dialogue: 0,0:01:24.33,0:01:29.04,On Top,,0,0,0,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:29.08,0:01:33.38,Default,,0,0,0,,{\i1}Seize it, dreamin' on{\i0}
Dialogue: 0,0:01:29.08,0:01:33.38,On Top,,0,0,0,,{\i1}tsukami toru Dreamin' on{\i0}
Dialogue: 0,0:01:33.80,0:01:38.76,Default,,0,0,0,,{\i1}I can't lose, I'll never run away{\i0}
Dialogue: 0,0:01:33.80,0:01:38.76,On Top,,0,0,0,,{\i1}makerarenai nige ya shinai{\i0}
