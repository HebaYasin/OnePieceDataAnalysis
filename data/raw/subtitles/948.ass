Dialogue: 0,0:01:18.57,0:01:21.49,Default,,0000,0000,0000,,{\i1}The flag that called forth oaths{\i0}
Dialogue: 0,0:01:21.53,0:01:24.24,On Top,,0000,0000,0000,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:21.53,0:01:24.24,Default,,0000,0000,0000,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:24.29,0:01:29.00,On Top,,0000,0000,0000,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:24.29,0:01:29.00,Default,,0000,0000,0000,,{\i1}Stay true to yourself{\i0}
Dialogue: 0,0:01:29.04,0:01:33.34,On Top,,0000,0000,0000,,{\i1}tsukami toru Dreamin' on{\i0}
Dialogue: 0,0:01:29.04,0:01:33.34,Default,,0000,0000,0000,,{\i1}Seize it, dreamin' on{\i0}
Dialogue: 0,0:01:33.75,0:01:38.72,On Top,,0000,0000,0000,,{\i1}makerarenai nige ya shinai{\i0}
Dialogue: 0,0:01:33.75,0:01:38.72,Default,,0000,0000,0000,,{\i1}I can't lose, I'll never run away{\i0}
Dialogue: 0,0:01:39.39,0:01:42.22,On Top,,0000,0000,0000,,{\i1}deai wakare koe ikou{\i0}
Dialogue: 0,0:01:39.39,0:01:42.22,Default,,0000,0000,0000,,{\i1}Transcend meetings and partings and keep going{\i0}
Dialogue: 0,0:01:42.26,0:01:46.56,On Top,,0000,0000,0000,,{\i1}zenbu takaramono{\i0}
Dialogue: 0,0:01:42.26,0:01:46.56,Default,,0000,0000,0000,,{\i1}They're all treasures{\i0}
