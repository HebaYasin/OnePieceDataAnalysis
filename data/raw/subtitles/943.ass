Dialogue: 0,0:00:36.93,0:00:40.18,Default,,0000,0000,0000,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:40.43,0:00:44.98,Default,,0000,0000,0000,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:40.43,0:00:44.98,Default,,0000,0000,0000,,{\i1}Shout it out, to save your spirit from breaking{\i0}
Dialogue: 0,0:00:45.02,0:00:47.44,Default,,0000,0000,0000,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:45.02,0:00:47.44,Default,,0000,0000,0000,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:47.48,0:00:53.86,Default,,0000,0000,0000,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:47.48,0:00:53.86,Default,,0000,0000,0000,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:53.90,0:00:57.95,Default,,0000,0000,0000,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:53.90,0:00:57.95,Default,,0000,0000,0000,,{\i1}Even when the darkness tries to tear you apart{\i0}
Dialogue: 0,0:00:57.99,0:00:59.24,Default,,0000,0000,0000,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:57.99,0:00:59.24,Default,,0000,0000,0000,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:59.28,0:01:00.74,Default,,0000,0000,0000,,{\i1}daijoubu sa{\i0}
Dialogue: 0,0:00:59.28,0:01:00.74,Default,,0000,0000,0000,,{\i1}It's going to be all right{\i0}
