Dialogue: 0,0:01:18.47,0:01:21.39,Default,,0000,0000,0000,,{\i1}The flag that called forth oaths{\i0}
Dialogue: 0,0:01:21.43,0:01:24.10,Default,,0000,0000,0000,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:21.43,0:01:24.10,Default,,0000,0000,0000,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:24.14,0:01:28.85,Default,,0000,0000,0000,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:24.14,0:01:28.85,Default,,0000,0000,0000,,{\i1}Stay true to yourself{\i0}
Dialogue: 0,0:01:28.90,0:01:33.19,Default,,0000,0000,0000,,{\i1}tsukami toru Dreamin' on{\i0}
Dialogue: 0,0:01:28.90,0:01:33.19,Default,,0000,0000,0000,,{\i1}Seize it, dreamin' on{\i0}
Dialogue: 0,0:01:33.61,0:01:38.57,Default,,0000,0000,0000,,{\i1}makerarenai nige ya shinai{\i0}
Dialogue: 0,0:01:33.61,0:01:38.57,Default,,0000,0000,0000,,{\i1}I can't lose, I'll never run away{\i0}
Dialogue: 0,0:01:39.24,0:01:42.08,Default,,0000,0000,0000,,{\i1}deai wakare koe ikou{\i0}
Dialogue: 0,0:01:39.24,0:01:42.08,Default,,0000,0000,0000,,{\i1}Transcend meetings and partings and keep going{\i0}
Dialogue: 0,0:01:42.12,0:01:46.41,Default,,0000,0000,0000,,{\i1}zenbu takaramono{\i0}
Dialogue: 0,0:01:42.12,0:01:46.41,Default,,0000,0000,0000,,{\i1}They're all treasures{\i0}
