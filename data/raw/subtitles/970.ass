Dialogue: 0,0:01:16.05,0:01:18.51,Default,,0,0,0,,{\i1}Open the borderless map{\i0}
Dialogue: 0,0:01:18.55,0:01:21.43,On Top,,0,0,0,,{\i1}chikai atsumeta hata{\i0}
Dialogue: 0,0:01:18.55,0:01:21.43,Default,,0,0,0,,{\i1}The flag that called forth oaths{\i0}
Dialogue: 0,0:01:21.47,0:01:24.18,On Top,,0,0,0,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:21.47,0:01:24.18,Default,,0,0,0,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:24.22,0:01:28.94,On Top,,0,0,0,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:24.22,0:01:28.94,Default,,0,0,0,,{\i1}Stay true to yourself{\i0}
Dialogue: 0,0:01:28.98,0:01:33.28,On Top,,0,0,0,,{\i1}tsukami toru Dreamin' on{\i0}
Dialogue: 0,0:01:28.98,0:01:33.28,Default,,0,0,0,,{\i1}Seize it, dreamin' on{\i0}
Dialogue: 0,0:01:33.69,0:01:38.66,On Top,,0,0,0,,{\i1}makerarenai nige ya shinai{\i0}
Dialogue: 0,0:01:33.69,0:01:38.66,Default,,0,0,0,,{\i1}I can't lose, I'll never run away{\i0}
Dialogue: 0,0:01:39.32,0:01:42.16,On Top,,0,0,0,,{\i1}deai wakare koe ikou{\i0}
Dialogue: 0,0:01:39.32,0:01:42.16,Default,,0,0,0,,{\i1}Transcend meetings and \Npartings and keep going{\i0}
Dialogue: 0,0:01:42.20,0:01:46.50,On Top,,0,0,0,,{\i1}zenbu takaramono{\i0}
Dialogue: 0,0:01:42.20,0:01:46.50,Default,,0,0,0,,{\i1}They're all treasures{\i0}
