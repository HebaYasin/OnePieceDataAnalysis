Dialogue: 0,0:00:16.95,0:00:21.45,On Top,,0,0,0,,{\i1}Let's sail on takaku ho wo agete{\i0}
Dialogue: 0,0:00:21.46,0:00:24.25,Default,,0,0,0,,{\i1}Catch the wind{\i0}
Dialogue: 0,0:00:21.50,0:00:24.25,On Top,,0,0,0,,{\i1}kaze ni nore{\i0}
Dialogue: 0,0:00:29.84,0:00:33.72,On Top,,0,0,0,,{\i1}Don't give up kakugo kimetano nara{\i0}
Dialogue: 0,0:00:29.84,0:00:33.73,Default,,0,0,0,,{\i1}Don't give up, if I'm determined{\i0}
Dialogue: 0,0:00:33.73,0:00:36.93,Default,,0,0,0,,{\i1}I'll never turn back{\i0}
Dialogue: 0,0:00:33.76,0:00:36.93,On Top,,0,0,0,,{\i1}hikikaeshi wa shinai sa{\i0}
Dialogue: 0,0:00:36.93,0:00:40.14,On Top,,0,0,0,,{\i1}waraitobase aranami{\i0}
Dialogue: 0,0:00:36.93,0:00:40.33,Default,,0,0,0,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:40.33,0:00:45.02,Default,,0,0,0,,{\i1}Shout it out, to save your spirit from breaking{\i0}
Dialogue: 0,0:00:40.51,0:00:45.02,On Top,,0,0,0,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:45.02,0:00:47.48,Default,,0,0,0,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:45.14,0:00:47.48,On Top,,0,0,0,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:47.53,0:00:53.90,Default,,0,0,0,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:47.56,0:00:53.90,On Top,,0,0,0,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:53.90,0:00:57.91,Default,,0,0,0,,{\i1}Even when the darkness tries to tear you apart{\i0}
Dialogue: 0,0:00:53.90,0:00:57.91,On Top,,0,0,0,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:57.91,0:00:59.28,Default,,0,0,0,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:58.07,0:00:59.28,On Top,,0,0,0,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:59.28,0:01:00.70,Default,,0,0,0,,{\i1}It's going to be all right{\i0}
Dialogue: 0,0:00:59.28,0:01:00.70,On Top,,0,0,0,,{\i1}daijoubu sa{\i0}
Dialogue: 0,0:01:00.70,0:01:04.55,Default,,0,0,0,,{\i1}Strong bonds will break through{\i0}
Dialogue: 0,0:01:00.87,0:01:04.54,On Top,,0,0,0,,{\i1}uchiyaburu saikyo no kizuna{\i0}
Dialogue: 0,0:01:04.54,0:01:07.29,On Top,,0,0,0,,{\i1}mugendai no chizu hiroge{\i0}
