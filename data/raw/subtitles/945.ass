Dialogue: 0,0:00:37.07,0:00:40.33,Default,,0000,0000,0000,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:40.58,0:00:45.12,Default,,0000,0000,0000,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:40.58,0:00:45.12,Default,,0000,0000,0000,,{\i1}Shout it out, to save your spirit from breaking{\i0}
Dialogue: 0,0:00:45.16,0:00:47.58,Default,,0000,0000,0000,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:45.16,0:00:47.58,Default,,0000,0000,0000,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:47.62,0:00:54.01,Default,,0000,0000,0000,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:47.62,0:00:54.01,Default,,0000,0000,0000,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:54.05,0:00:58.09,Default,,0000,0000,0000,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:54.05,0:00:58.09,Default,,0000,0000,0000,,{\i1}Even when the darkness tries to tear you apart{\i0}
Dialogue: 0,0:00:58.14,0:00:59.39,Default,,0000,0000,0000,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:58.14,0:00:59.39,Default,,0000,0000,0000,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:59.43,0:01:00.89,Default,,0000,0000,0000,,{\i1}daijoubu sa{\i0}
Dialogue: 0,0:00:59.43,0:01:00.89,Default,,0000,0000,0000,,{\i1}It's going to be all right{\i0}
