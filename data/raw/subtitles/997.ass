Dialogue: 0,0:00:40.45,0:00:45.00,On Top,,0,0,0,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:40.45,0:00:45.00,Default,,0,0,0,,{\i1}Shout it out, to save \Nyour spirit from breaking{\i0}
Dialogue: 0,0:00:45.04,0:00:47.46,On Top,,0,0,0,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:45.04,0:00:47.46,Default,,0,0,0,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:47.50,0:00:53.88,On Top,,0,0,0,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:47.50,0:00:53.88,Default,,0,0,0,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:53.92,0:00:57.97,On Top,,0,0,0,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:53.92,0:00:57.97,Default,,0,0,0,,{\i1}Even when the darkness \Ntries to tear you apart{\i0}
Dialogue: 0,0:00:58.01,0:00:59.26,On Top,,0,0,0,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:58.01,0:00:59.26,Default,,0,0,0,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:59.30,0:01:00.76,On Top,,0,0,0,,{\i1}daijoubu sa{\i0}
