Dialogue: 0,0:01:21.37,0:01:24.12,On Top,,0,0,0,,{\i1}tatakai tsudukete iku{\i0}
Dialogue: 0,0:01:21.37,0:01:24.12,Default,,0,0,0,,{\i1}Keep fighting on{\i0}
Dialogue: 0,0:01:24.16,0:01:28.88,On Top,,0,0,0,,{\i1}"jibunjishin" tsuranuke{\i0}
Dialogue: 0,0:01:24.16,0:01:28.88,Default,,0,0,0,,{\i1}Stay true to yourself{\i0}
Dialogue: 0,0:01:28.92,0:01:33.21,On Top,,0,0,0,,{\i1}tsukami toru Dreamin' on{\i0}
Dialogue: 0,0:01:28.92,0:01:33.21,Default,,0,0,0,,{\i1}Seize it, dreamin' on{\i0}
Dialogue: 0,0:01:33.63,0:01:38.59,On Top,,0,0,0,,{\i1}makerarenai nige ya shinai{\i0}
Dialogue: 0,0:01:33.63,0:01:38.59,Default,,0,0,0,,{\i1}I can't lose, I'll never run away{\i0}
Dialogue: 0,0:01:39.26,0:01:42.10,On Top,,0,0,0,,{\i1}deai wakare koe ikou{\i0}
Dialogue: 0,0:01:39.26,0:01:42.10,Default,,0,0,0,,{\i1}Transcend meetings and \Npartings and keep going{\i0}
