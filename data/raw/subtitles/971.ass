Dialogue: 0,0:00:16.82,0:00:21.37,Default,,0,0,0,,{\i1}Let's sail on, raise high the sails{\i0}
Dialogue: 0,0:00:16.82,0:00:21.37,On Top,,0,0,0,,{\i1}Let's sail on takaku ho wo agete{\i0}
Dialogue: 0,0:00:21.41,0:00:24.12,Default,,0,0,0,,{\i1}Catch the wind{\i0}
Dialogue: 0,0:00:21.41,0:00:24.12,On Top,,0,0,0,,{\i1}kaze ni nore{\i0}
Dialogue: 0,0:00:29.75,0:00:33.63,Default,,0,0,0,,{\i1}Don't give up, if I'm determined{\i0}
Dialogue: 0,0:00:29.75,0:00:33.63,On Top,,0,0,0,,{\i1}Don't give up kakugo kimetano nara{\i0}
Dialogue: 0,0:00:33.67,0:00:36.89,Default,,0,0,0,,{\i1}I'll never turn back{\i0}
Dialogue: 0,0:00:33.67,0:00:36.89,On Top,,0,0,0,,{\i1}hikikaeshi wa shinai sa{\i0}
Dialogue: 0,0:00:36.93,0:00:40.18,Default,,0,0,0,,{\i1}Laugh on through troubled waters{\i0}
Dialogue: 0,0:00:36.93,0:00:40.18,On Top,,0,0,0,,{\i1}waraitobase aranami{\i0}
Dialogue: 0,0:00:40.43,0:00:44.98,Default,,0,0,0,,{\i1}Shout it out, to save \Nyour spirit from breaking{\i0}
Dialogue: 0,0:00:40.43,0:00:44.98,On Top,,0,0,0,,{\i1}Shout it out kokoro kudakenai youni{\i0}
Dialogue: 0,0:00:45.02,0:00:47.44,Default,,0,0,0,,{\i1}Your friends are there for you{\i0}
Dialogue: 0,0:00:45.02,0:00:47.44,On Top,,0,0,0,,{\i1}nakama ga irun da{\i0}
Dialogue: 0,0:00:47.48,0:00:53.86,Default,,0,0,0,,{\i1}Hey, you don't ever need to act tough{\i0}
Dialogue: 0,0:00:47.48,0:00:53.86,On Top,,0,0,0,,{\i1}hora tsuyogari nante iranai itsudatte{\i0}
Dialogue: 0,0:00:53.90,0:00:57.95,Default,,0,0,0,,{\i1}Even when the darkness \Ntries to tear you apart{\i0}
Dialogue: 0,0:00:53.90,0:00:57.95,On Top,,0,0,0,,{\i1}yami ga hikisakou toshitemo{\i0}
Dialogue: 0,0:00:57.99,0:00:59.24,Default,,0,0,0,,{\i1}Come on, brave it out{\i0}
Dialogue: 0,0:00:57.99,0:00:59.24,On Top,,0,0,0,,{\i1}hora Brave it out{\i0}
Dialogue: 0,0:00:59.28,0:01:00.74,Default,,0,0,0,,{\i1}It's going to be all right{\i0}
Dialogue: 0,0:00:59.28,0:01:00.74,On Top,,0,0,0,,{\i1}daijoubu sa{\i0}
Dialogue: 0,0:01:00.78,0:01:04.45,Default,,0,0,0,,{\i1}Strong bonds will break through{\i0}
Dialogue: 0,0:01:00.78,0:01:04.45,On Top,,0,0,0,,{\i1}uchiyaburu saikyo no kizuna{\i0}
